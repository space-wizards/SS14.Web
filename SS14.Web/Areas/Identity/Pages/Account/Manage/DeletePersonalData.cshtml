@page
@using Microsoft.Extensions.Options
@using SS14.Auth.Shared.Config
@using SS14.Auth.Shared.Data
@model DeletePersonalDataModel
@inject SpaceUserManager UserManager
@inject IOptions<AccountConfiguration> Config
@{
    ViewData["Title"] = "Delete Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h4>@ViewData["Title"]</h4>
<partial name="_StatusMessage" model="Model.StatusMessage" />

<div class="alert alert-info" role="alert">
    <p>
        Currently deletion requests are not forwarded to third party services including other games on the hub and services using Space Station 14 authentication not owned by us.
    </p>
</div>


@if (await UserManager.GetDaysUntilDeletionAsync(User) is {} timeSpan)
{
    var deletionTimeText = timeSpan.Days < 0 ? "soon" : $"in {timeSpan.Days} days";

    <div>
        Your account is marked for deletion and will be deleted @deletionTimeText<br/>
        Cancel the deletion process by clicking the button below.
    </div>

    <div class="mt-3">
        <form id="cancel-deletion" method="post" class="form-group">
            <button class="btn btn-danger" type="submit" asp-page-handler="Cancel">Cancel deletion</button>
        </form>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        <p>
            <strong>Deleting this data will permanently remove your account and this cannot be recovered.</strong><br/>
            After confirming that you want to delete your account it will be deleted after @Config.Value.UserDeletionGracePeriodDays days unless you cancel the deletion process.
        </p>
    </div>

    <div>
        <form id="delete-user" method="post" class="form-group">
            <div asp-validation-summary="All" class="text-danger"></div>
            @if (Model.RequirePassword)
            {
                <div class="form-group">
                    <label asp-for="Input.Password"></label>
                    <input asp-for="Input.Password" class="form-control" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
            }
            <button class="btn btn-danger" type="submit" asp-page-handler="Delete">Delete data and close my account</button>
        </form>
    </div>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
